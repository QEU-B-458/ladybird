#include <AK/String.h>

endpoint Supervisor
{
    // Handshake
    hello(String role, u32 protocol_version, u32 process_id, String launch_token, String world_package) => (bool ok, u64 session_id, u32 world_id, Vector<String> capabilities)

    // Notifications (Worker to Supervisor)
    world_state_changed(u32 world_id, String state) =|
    log_event(u32 world_id, String message) =|

    // World Actions (Worker to Supervisor/Host)
    spawn_entity() => (u32 entity_id)
    destroy_entity(u32 entity_id) => (bool ok)

    // Component Updates (Worker to Host)
    set_mesh(u32 entity_id, String mesh) => (bool ok)
    set_material(u32 entity_id, String material) => (bool ok)
    set_normal_map(u32 entity_id, String path) => (bool ok)
    create_panel(u32 entity_id, String url, float width, float height) => (bool ok)

    // Log redirection (Worker to Host)
    script_log(String level, String source, String message) =|
}
